# ==============================================================================
# SatQuery AI — Environment Configuration Template
# Copy this file to `.env` and configure your API keys and endpoints.
# ==============================================================================

# --- Online LLM Planner & Synthesis Configuration ---
# Supported providers: "nvidia" (Nemotron), "openai", "gemini" (or leave blank for deterministic rule-based fallback)
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_API_KEY=
LLM_TIMEOUT=120

# NVIDIA NIM Specific Parameters (Optional overrides)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_NIM_TIMEOUT=120

# --- GeoChat-7B Remote GPU Service Configuration ---
# Set to "true" to enable GeoChat remote multimodal vision reasoning
GEOCHAT_ENABLED=false
# Public HTTPS tunnel URL or GPU endpoint (e.g., https://your-colab-tunnel.trycloudflare.com)
GEOCHAT_API_URL=
# Secure authentication key shared between SatQuery and GeoChat FastAPI server
GEOCHAT_API_KEY=
# Timeout for remote inference in seconds
GEOCHAT_TIMEOUT=120

# --- Application Observability ---
LOG_LEVEL=INFO
